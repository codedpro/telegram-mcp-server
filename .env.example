# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional. Normally the agent logs you in (telegram_login_start) and the session
# is saved to ~/.telegram-mcp-server/session. Set this to use a session string
# from elsewhere instead. It is a full login to your account - keep it secret.
TELEGRAM_SESSION=

# Optional overrides.
# TELEGRAM_SESSION_FILE=/path/to/session
# TELEGRAM_DOWNLOAD_DIR=/path/to/downloads

# Optional restriction. Unset = the agent may write to every chat.
# Comma-separated ids/usernames limit which chats it can send/edit/delete/forward in.
# TELEGRAM_WRITE_ALLOWLIST=me,@my_test_group
