# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Produced by `npm run login` - keep it secret, it is a full account session
TELEGRAM_SESSION=

# Comma-separated chat ids/usernames the agent is allowed to write to.
# Leave empty to run read-only. "*" allows every chat (not recommended).
TELEGRAM_WRITE_ALLOWLIST=
